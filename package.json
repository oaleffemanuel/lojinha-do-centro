{
  "name": "lojinha-do-centro",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "next build",
    "start": "python3 -m http.server 3200 --directory out --bind 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/checkout.test.ts tests/static-storefront.test.ts",
    "test:backend": "vitest run tests/auth.test.ts tests/orders.test.ts tests/catalog.test.ts",
    "test:covers": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -p 'test_*.py'",
    "covers:enrich": "python3 scripts/enrich-covers.py",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed-catalog.mjs"
  },
  "dependencies": {
    "next": "^15.5.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
